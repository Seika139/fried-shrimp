{
  "name": "OpenClaw Dev",
  "dockerComposeFile": ["../docker-compose.yml", "./docker-compose.dev.yml", "./docker-compose.gen.yml"],
  "service": "openclaw-gateway",
  "workspaceFolder": "/app",
  "initializeCommand": "bash .devcontainer/setup-env.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "firsttris.vscode-jest-runner",
        "DavidAnson.vscode-markdownlint",
        "Orta.vscode-jest",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "installZsh": true,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers-contrib/features/fzf:1": {},
    "ghcr.io/devcontainers-contrib/features/fd:1": {},
    "ghcr.io/devcontainers-contrib/features/eza:1": {},
    "ghcr.io/devcontainers-contrib/features/zoxide:1": {},
    "ghcr.io/devcontainers-contrib/features/ripgrep:1": {},
    "ghcr.io/devcontainers-contrib/features/dotenvx:1": {},
    "ghcr.io/devcontainers-contrib/features/mise:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.openclaw,target=/home/node/.openclaw,type=bind,consistency=cached"
  ]
}
